{
  "version": "0.16.36",
  "name": "react-atomic-organism",
  "repository": {
    "type": "git",
    "url": "https://github.com/react-atomic/react-atomic-organism"
  },
  "description": "Atomic design in React (organisms)",
  "keywords": [
    "react-atomic",
    "react-atomic-ui"
  ],
  "author": "Hill <hill@kimo.com>",
  "license": "MIT",
  "dependencies": {
    "array.merge": "^0.2.2",
    "call-func": "^0.5.3",
    "form-serialize-js": "^0.1.0",
    "get-object-value": "^0.8.1",
    "get-random-id": "^0.5.0",
    "prop-types": "^15.8.1",
    "react-atomic-atom": "^19.0.0",
    "react-atomic-molecule": "^19.0.0",
    "reshow-constant": "^0.18.0",
    "reshow-hooks": "^0.18.4",
    "ricon": "^0.5.4",
    "seturl": "^0.7.1",
    "win-doc": "^0.4.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.9",
    "@types/react": "^19.x",
    "@types/react-dom": "^19.x",
    "lerna": "^10.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reshow-unit": "^0.19.2",
    "typescript": "^7.0.2"
  },
  "main": "./build/cjs/src/index.js",
  "module": "./build/es/src/index.mjs",
  "exports": {
    "types": "./types/index.d.ts",
    "require": "./build/cjs/src/index.js",
    "import": "./build/es/src/index.mjs"
  },
  "scripts": {
    "up-all": "lerna exec yarn upgrade",
    "format": "prettier-eslint --write '**/src/**/*.js'",
    "clean": "find ./build ./types -name '*.*' | xargs rm -rf",
    "build:cjs": "BABEL_ENV=cjs babel src -d build/cjs/src --ignore /**/__tests__",
    "build:es": "BABEL_ENV=es babel src -d build/es/src --out-file-extension .mjs",
    "build:type": "tsc src/*.js $(find src -name \"*.jsx\" -not -path \"*/__tests__/*\") --jsx react-jsx --declaration --allowJs --emitDeclarationOnly --skipLibCheck --declarationDir types --resolvePackageJsonExports false --strict false",
    "build": "npm run clean && npm run build:cjs && npm run build:es && npm run build:type",
    "mochaFor": "STRICT_MODE=1 mocha -r global-jsdom/register",
    "mocha": "npm run mochaFor -- 'build/es/**/__tests__/*.mjs'",
    "test:report": "npm run build && npm run mochaFor -- --reporter mocha-junit-reporter --reporter-options mochaFile=./test_output/mocha.xml 'build/es/**/__tests__/*.mjs'",
    "test": "npm run build && npm run mocha",
    "prepublishOnly": "npm run test"
  },
  "types": "./types/index.d.ts",
  "files": [
    "types",
    "build",
    "package.json",
    "README.md"
  ]
}
