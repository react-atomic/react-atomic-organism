{
  "name": "organism-react-geometryangle",
  "version": "0.1.0",
  "description": "geometryangle for npm and reactjs",
  "repository": "react-atomic/react-atomic-organism",
  "main": "./build/cjs/src/index.js",
  "module": "./build/es/src/index.js",
  "keywords": [
    "react",
    "reactjs"
  ],
  "author": "Hill <hill@kimo.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.x",
    "@types/react-dom": "^19.x",
    "react": "^19.x",
    "react-dom": "^19.x",
    "reshow-app": "*",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "start": "ws",
    "webpack": "webpack",
    "clean:webpack": "find ./assets -name '*.*' | xargs rm -rf",
    "clean": "find ./build ./types -name '*.*' | xargs rm -rf",
    "build:cjs": "BABEL_ENV=cjs babel src -d build/cjs/src --ignore /**/__tests__ --root-mode upward",
    "build:es": "BABEL_ENV=es babel src -d build/es/src --out-file-extension .mjs --root-mode upward",
    "build:type": "tsc src/*.js $(find src -name \"*.jsx\" -not -path \"*/__tests__/*\") --jsx react-jsx --declaration --allowJs --emitDeclarationOnly --skipLibCheck --declarationDir types --resolvePackageJsonExports false --strict false",
    "build": "npm run clean && npm run build:cjs && npm run build:es && npm run build:type",
    "mochaFor": "STRICT_MODE=on mocha -r global-jsdom/register",
    "mocha": "npm run mochaFor -- 'build/es/**/__tests__/*.mjs'",
    "test": "npm run build && npm run mocha",
    "prepublishOnly": "npm run test"
  },
  "files": [
    "build",
    "package.json",
    "README.md"
  ]
}
