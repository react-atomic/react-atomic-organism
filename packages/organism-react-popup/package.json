{
  "version": "0.19.0",
  "name": "organism-react-popup",
  "repository": {
    "type": "git",
    "url": "https://github.com/react-atomic/react-atomic-organism",
    "directory": "packages/organism-react-popup"
  },
  "homepage": "https://github.com/react-atomic/react-atomic-organism/tree/main/packages/organism-react-popup",
  "description": "React Atomic Organism Popup",
  "keywords": [
    "react",
    "react-component",
    "organism",
    "atomic-ui"
  ],
  "author": "Hill <hill@kimo.com>",
  "license": "MIT",
  "dependencies": {
    "array.merge": "^0.2.2",
    "call-func": "^0.5.3",
    "class-lib": "^0.2.1",
    "get-object-value": "^0.8.1",
    "get-random-id": "^0.5.0",
    "get-style": "^0.2.1",
    "get-window-offset": "^0.11.1",
    "getoffset": "^0.6.4",
    "need-css": "^0.3.0",
    "organism-react-animate": "^0.12.5",
    "prop-types": "^15.8.1",
    "react-atomic-molecule": "^19.0.0",
    "reshow-build": "^1.19.2",
    "reshow-constant": "^0.18.0",
    "reshow-flux": "^0.19.3",
    "reshow-hooks": "^0.18.4",
    "reshow-return": "^0.19.5",
    "reshow-runtime": "^0.17.15",
    "ricon": "^0.5.4",
    "set-object-value": "^0.2.0",
    "to-percent-js": "^0.4.2",
    "win-doc": "^0.4.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reshow-unit": "^0.19.3",
    "typescript": "^7.0.2"
  },
  "exports": {
    "types": "./types/index.d.ts",
    "require": "./build/cjs/index.js",
    "import": "./build/es/index.mjs"
  },
  "main": "./build/cjs/index.js",
  "module": "./build/es/index.mjs",
  "scripts": {
    "clean": "find ./build ./types -name '*.*' | xargs rm -rf",
    "build:cjs": "BABEL_ENV=cjs babel src -d build/cjs --ignore /**/__tests__ --root-mode upward",
    "build:es": "BABEL_ENV=es babel src -d build/es --out-file-extension .mjs --root-mode upward",
    "build:type": "tsc src/*.js $(find src -name \"*.js\" -not -path \"*/__tests__/*\") $(find src -name \"*.jsx\" -not -path \"*/__tests__/*\") --jsx react-jsx --declaration --allowJs --emitDeclarationOnly --skipLibCheck --declarationDir types --resolvePackageJsonExports false --strict false",
    "build": "npm run clean && npm run build:cjs && npm run build:es && npm run build:type",
    "mochaFor": "STRICT_MODE=on mocha -r global-jsdom/register",
    "mocha": "npm run mochaFor -- 'build/es/**/__tests__/*.mjs'",
    "test:report": "npm run build && npm run mochaFor -- --reporter mocha-junit-reporter --reporter-options mochaFile=./test_output/mocha.xml 'build/es/**/__tests__/*.mjs'",
    "test": "npm run build && npm run mocha",
    "prepublishOnly": "npm run test"
  },
  "types": "./types/index.d.ts",
  "files": [
    "types",
    "build",
    "package.json",
    "README.md"
  ]
}
